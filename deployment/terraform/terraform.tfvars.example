# Copy to terraform.tfvars and adjust. This "lab" profile keeps the architecture but lowers cost and lets
# `terraform destroy` remove everything.
project     = "scalable-webapp"
environment = "lab"
region      = "eu-west-3"

nat_gateway_per_az      = false # one NAT Gateway instead of two (not highly available, about 35 USD/month less)
db_deletion_protection  = false
db_skip_final_snapshot  = true
alb_deletion_protection = false

alarm_email = "you@example.com"

# Optional custom domain (a Route 53 public hosted zone you own):
# domain_name    = "example.com"
# hosted_zone_id = "Z0123456789ABCDEFGHIJ"
